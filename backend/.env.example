# Server
PORT=5000
AUTH_SECRET=a long random string
ALLOWED_ORIGINS=https://talentvetting.vercel.app,http://localhost:5173
# Database (MongoDB Atlas); DNS_SERVERS is optional (comma separated), public resolvers are used when SRV lookups fail
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/talentvetting
DNS_SERVERS=8.8.8.8,1.1.1.1
# AI providers: gemini (Gemma on the Gemini API), groq, hf (Hugging Face)
LLM_PROVIDER=gemini
SUMMARY_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HF_TOKEN=
HF_MODEL=google/gemma-3-27b-it
